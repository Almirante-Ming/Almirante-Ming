# ---------------------------------------------------------------------------
# Media stack - configuracao compartilhada pelos 3 composes
# Copie para .env  (cp .env.example .env)  e ajuste.
# ---------------------------------------------------------------------------

# Usuario dono dos arquivos dentro dos containers (id -u / id -g)
PUID=1000
PGID=1000
UMASK=002
TZ=Europe/Berlin

# ---- Caminhos no host -----------------------------------------------------
# MEDIA_ROOT precisa ser UM unico filesystem para hardlink/atomic-move funcionar
MEDIA_ROOT=/home/SEU_USUARIO/media
DOWNLOADS_DIR=/home/SEU_USUARIO/media/downloads
CONTENT_DIR=/home/SEU_USUARIO/media/content
CONFIG_ROOT=./config

# ---- Rede compartilhada ---------------------------------------------------
# Criada uma vez com: docker network create medianet
MEDIA_NETWORK=medianet

# ---- Portas publicadas no host (todas 7xxx) -------------------------------
PROWLARR_PORT=7696
SONARR_PORT=7989
RADARR_PORT=7878
BAZARR_PORT=7767
FLARESOLVERR_PORT=7191
TRANSMISSION_PORT=7091
TRANSMISSION_PEER_PORT=51413
PLEX_PORT=32400

# ---- API keys fixas (injetadas via env nos apps *arr) ---------------------
# Gere as suas:  openssl rand -hex 16
SONARR_API_KEY=CHANGE_ME_32_HEX
RADARR_API_KEY=CHANGE_ME_32_HEX
PROWLARR_API_KEY=CHANGE_ME_32_HEX

# ---- URLs internas (hostname == nome do container na medianet) ------------
SONARR_INTERNAL_URL=http://sonarr:8989
RADARR_INTERNAL_URL=http://radarr:7878
PROWLARR_INTERNAL_URL=http://prowlarr:9696
BAZARR_INTERNAL_URL=http://bazarr:6767
FLARESOLVERR_INTERNAL_URL=http://flaresolverr:8191
TRANSMISSION_INTERNAL_URL=http://transmission:9091

# ---- Transmission ---------------------------------------------------------
TRANSMISSION_USER=admin
TRANSMISSION_PASS=CHANGE_ME
TRANSMISSION_RPC_URL=/transmission/

# ---- Plex -----------------------------------------------------------------
# Pegue em https://www.plex.tv/claim (valido por 4 minutos)
PLEX_CLAIM=
# IP/porta que o Plex anuncia para os clientes (ajuste para o IP do host)
PLEX_ADVERTISE_IP=http://192.168.1.10:32400
